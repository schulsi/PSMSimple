# Database - Postgres
POSTGRES_USER=psm_user
POSTGRES_PASSWORD=psm_pass
POSTGRES_DB=psm_db

# Database - MySQL
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_DATABASE=psm_db
MYSQL_USER=psm_user
MYSQL_PASSWORD=psm_pass

# App settings
SECRET_KEY=change_me
DATA_DIR=/data
RATELIMIT_STORAGE_URI=redis://redis:6379/0
ENVIRONMENT=production

# Optional explicit URIs (set to override constructed URIs above)
#SQLALCHEMY_DATABASE_URI=
#APP_DB_URI=
#USER_DB_URI=
# Flask Secret Key - Für Produktion einen sicheren Zufallswert generieren!
SECRET_KEY=your-secret-key-change-in-production

# Redis ist automatisch unter redis:6379 erreichbar
# RATELIMIT_STORAGE_URI wird automatisch auf redis://redis:6379/0 gesetzt

# Authentifizierung: local, hybrid oder oidc
AUTH_MODE=local

# OIDC/SSO (erforderlich bei AUTH_MODE=hybrid oder AUTH_MODE=oidc)
OIDC_PROVIDER_NAME=SSO
OIDC_ISSUER=https://identity.example.com/realms/example
OIDC_CLIENT_ID=psmsimple
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_SCOPES=openid profile email
OIDC_DEFAULT_ROLE=read-only
OIDC_AUTO_PROVISION=false
